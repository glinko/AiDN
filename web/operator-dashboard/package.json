{
  "name": "@aidn/operator-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:report": "node scripts/report-bundle.mjs",
    "bundle:repro": "node scripts/check-reproducible-build.mjs",
    "lint": "oxlint",
    "verify:theme": "node scripts/verify-spatial-theme.mjs",
    "verify:prototype": "node scripts/verify-spatial-prototype.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/classic-dashboard.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:theme": "playwright test tests/e2e/spatial-theme.spec.ts --project=chromium",
    "test:prototype": "playwright test tests/e2e/spatial-prototype.spec.ts --project=chromium",
    "test:bundle": "playwright test --config playwright.bundle.config.ts",
    "verify:licenses": "node scripts/verify-dependency-licenses.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.185.1",
    "three-stdlib": "2.36.1",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
