# AiDN operator configuration (example)
#
# Copy this file to the EnvironmentFile used by the service, for example:
#   /etc/aidn/hypervisor.env       (system-wide systemd deployment)
# or keep the values in the bootstrap-generated run-hypervisor.sh wrapper
# (tools/aidn-operator-bootstrap-ubuntu.sh). Never commit a populated copy.
#
# Precedence (highest first):
#   1. an explicit CLI/request value;
#   2. an applied dashboard configuration (for consensus fields);
#   3. these AIDN_* environment variables;
#   4. the source-code default.
#
# Secrets are deliberately absent. Put tokens and signing keys in the local
# Secret Manager (AIDN_SECRET_MANAGER_PATH) or an equivalent secret injector.

# ---------------------------------------------------------------------------
# Node identity, persistent state, and dashboard
# ---------------------------------------------------------------------------
# Unique node and operator identities. Bootstrap normally sets both to the
# sanitized operator name.
# AIDN_NODE_ID=node-example
# AIDN_OPERATOR_ID=operator-example

# AIDN_HYPERVISOR_STATE_PATH=/var/lib/aidn/hypervisor-state.json
# AIDN_HYPERVISOR_BUNDLES_PATH=/var/lib/aidn/bundles.json
# Leave unset to use the sibling "models" directory next to the state file.
# AIDN_HYPERVISOR_MODEL_STORE_PATH=/var/lib/aidn/models

# Local Secret Manager. The master key must be injected by the host secret
# mechanism (file mode 0600 or an equivalent systemd credential), never stored
# in this checked-in template.
# AIDN_SECRET_MANAGER_PATH=/var/lib/aidn/registry-replication/secrets.json
# AIDN_SECRET_MANAGER_MASTER_KEY=

# The operator CLI can use this URL when it is not running in-process. The
# dashboard itself does not need this variable.
# AIDN_OPERATOR_API_URL=http://127.0.0.1:8766

# The systemd template defaults to loopback. A LAN bind must be an explicit
# operator decision and must be paired with browser pairing/HTTPS controls.
AIDN_HYPERVISOR_API_HOST=127.0.0.1
AIDN_HYPERVISOR_API_PORT=8766
# Path containing the selected dashboard bind host (written by the dashboard
# access operation). If set, the value is authoritative on restart.
# AIDN_HYPERVISOR_BIND_HOST_PATH=/var/lib/aidn/hypervisor-bind-host
AIDN_HYPERVISOR_RESTART_ON_BIND_CHANGE=true
# Only enable this when the trusted LAN boundary is intentional. It does not
# provide authentication by itself.
# AIDN_DASHBOARD_ACCESS_ALLOW_INSECURE_LAN=true

# ---------------------------------------------------------------------------
# Host capacity and optional custody
# ---------------------------------------------------------------------------
AIDN_RESOURCE_PROBE_MODE=auto
# Persisted probe report; if invalid, the service falls back to a live probe.
# AIDN_RESOURCE_CAPACITY_PATH=/var/lib/aidn/resource-capacity.json
# Test/diagnostic override only; JSON object such as {"gpu0":24576}.
# AIDN_RESOURCE_GPU_VRAM_JSON={"gpu0":24576}
# Optional endpoint custody signing key. Treat as a secret; do not put it in
# this file in production.
# AIDN_HYPERVISOR_CUSTODY_SIGNING_KEY=

# ---------------------------------------------------------------------------
# MCP control plane and local-agent access
# ---------------------------------------------------------------------------
# Safe default is disabled. Bootstrap enables it only after credentials and a
# secret manager have been prepared.
AIDN_MCP_REMOTE_ENABLED=false
# Required when remote access is enabled unless a Secret Manager is configured.
# AIDN_MCP_REMOTE_TOKEN=
# Optional separate operator token. It must differ from the agent token.
# AIDN_MCP_OPERATOR_TOKEN=
AIDN_MCP_REMOTE_HOST=127.0.0.1
AIDN_MCP_REMOTE_PORT=8766
AIDN_MCP_REMOTE_TLS_REQUIRED=false
# TLS file/handle options are mutually deployment-specific. Prefer handles
# backed by the Secret Manager over plaintext files.
# AIDN_MCP_TLS_CERTFILE=
# AIDN_MCP_TLS_KEYFILE=
# AIDN_MCP_TLS_CA_FILE=
# AIDN_MCP_TLS_CERT_HANDLE=
# AIDN_MCP_TLS_KEY_HANDLE=
# AIDN_MCP_TLS_CA_HANDLE=
AIDN_MCP_TLS_RELOAD_SECONDS=5

# The stateless profile is recommended for a local agent that reconnects often.
# With stateless=true, expires_at is omitted and no MCP session TTL can expire.
# AIDN_MCP_CONTROL_SESSION_STATELESS=true
AIDN_MCP_CONTROL_SESSION_AUTO_RENEW=false
AIDN_MCP_CONTROL_SESSION_TTL_SECONDS=3600
# Optional stable identities. Defaults are agent:local, the node operator, and
# acs-local-default for the control session.
# AIDN_MCP_AGENT_IDENTITY=agent:local
# AIDN_MCP_OPERATOR_IDENTITY=operator-example
# AIDN_MCP_CONTROL_SESSION_ID=acs-local-default
# Comma-separated scopes. Keep mutation scopes out unless explicitly needed.
# AIDN_MCP_SCOPES=CAPABILITIES:READ,HOST:READ,NODE:READ,NETWORK:READ,PROVIDER:READ,MODEL:READ,BUNDLE:READ,ENDPOINT:READ,RESOURCES:READ,SCHEDULER:READ,WALLET:READ,BUDGET:READ,AUDIT:READ
# Restricts the read_file/terminal-style MCP host boundary.
# AIDN_MCP_HOST_ROOT=/var/lib/aidn

# The following variables are generated for an installed provider container and
# are not operator configuration. They must not be hand-edited: the Hypervisor
# derives them from the approved plugin installation and sends the activation
# secret through a protected file descriptor/path.
# AIDN_PLUGIN_HOST_INSTALLED_PLUGIN_ID=<generated>
# AIDN_PLUGIN_HOST_PLUGIN_ID=<generated>
# AIDN_PLUGIN_HOST_INSTALLATION_GENERATION=<generated>
# AIDN_PLUGIN_HOST_ACTIVATION_CREDENTIAL_KEY_ID=<generated>
# AIDN_PLUGIN_HOST_ACTIVATION_SECRET_FILE=/run/aidn-plugin-host-activation-secret

# ---------------------------------------------------------------------------
# Inference request guardrails
# ---------------------------------------------------------------------------
# These are node-side admission limits, not the model's context window. The
# model context belongs to the Bundle revision/runtime parameter policy.
AIDN_INFERENCE_MAX_REQUEST_BYTES=4194304
AIDN_INFERENCE_MAX_MESSAGES=512
# Optional public base URL used when the node advertises a local-agent route.
# AIDN_INFERENCE_PUBLIC_BASE_URL=http://127.0.0.1:8766

# ---------------------------------------------------------------------------
# Consensus / CometBFT
# ---------------------------------------------------------------------------
# Consensus is fail-closed unless enabled by bootstrap or an applied dashboard
# install/reconnect configuration.
AIDN_CONSENSUS_MODE=disabled
# AIDN_CONSENSUS_NODE_ID=node-example
# AIDN_CONSENSUS_VALIDATOR_PUBKEY=
# AIDN_CONSENSUS_STRICT_OPERATION_COVERAGE=true
AIDN_COMETBFT_ENDPOINT=tcp://127.0.0.1:26657
AIDN_COMETBFT_CHAIN_ID=aidn-localnet-1
# AIDN_COMETBFT_SERVICE=aidn-cometbft-node-example.service
# AIDN_COMETBFT_CONFIG_PATH=/var/lib/aidn/consensus/cometbft/config/config.toml
# Required only for validator mode.
# AIDN_COMETBFT_ABCI_STATE_PATH=/var/lib/aidn/consensus/abci-state
AIDN_COMETBFT_ABCI_HOST=127.0.0.1
AIDN_COMETBFT_ABCI_PORT=26658
AIDN_COMETBFT_ABCI_QUERY_TIMEOUT_SECONDS=10
AIDN_COMETBFT_ABCI_RETAINED_SNAPSHOTS=8
AIDN_COMETBFT_ABCI_SNAPSHOT_LEASE_SECONDS=1800
# Install/review broker (required by the dashboard CometBFT wizard).
# AIDN_ENABLE_PROVIDER_RUNTIME_INSTALL=true
# AIDN_PROVIDER_RUNTIME_DISPATCHER=/usr/libexec/aidn-provider-runtime/aidn-provider-runtime-ubuntu.sh
# AIDN_PROVIDER_RUNTIME_BROKER_SOCKET=@aidn-provider-runtime-1000
# AIDN_PROVIDER_RUNTIME_OPERATOR_NAME=aidn
# AIDN_PROVIDER_RUNTIME_OPERATOR_UID=1000
# AIDN_PROVIDER_RUNTIME_OPERATOR_GID=1000
# AIDN_PROVIDER_RUNTIME_OPERATOR_HOME=/home/aidn

# ---------------------------------------------------------------------------
# Registry, finality, epoch, and policy inputs
# ---------------------------------------------------------------------------
# These files are signed/validated artifacts; paths are configurable but their
# schema and verification rules are protocol boundaries.
# AIDN_REGISTRY_REPLICATION_CONFIG=/var/lib/aidn/registry-replication.json
# AIDN_REMOTE_TRUST_ANCHOR_CONFIG=/etc/aidn/remote-trust-anchor.json
# AIDN_COMETBFT_FINALITY_CONFIG=/etc/aidn/cometbft-finality.json
# AIDN_PROTOCOL_AUTHORITY_POLICY_PATH=/etc/aidn/protocol-authority-policy.json
# AIDN_PROTOCOL_AUTHORITY_POLICY_JSON=
# AIDN_NETWORK_ID=aidn
# Epoch scheduling is optional; setting duration requires a start time.
# AIDN_EPOCH_DURATION_SECONDS=86400
# AIDN_EPOCH_START_TIME=2026-01-01T00:00:00Z
# AIDN_EPOCH_PARAMETER_VERSION=genesis
# AIDN_EPOCH_TASK_SET_VERSION=genesis
# AIDN_EPOCH_PROTOCOL_VERSION=0.1
# AIDN_CONSENSUS_GENESIS_ACCOUNTS_JSON={}
# AIDN_FAUCET_TREASURY_GENESIS_MANIFEST=/etc/aidn/faucet-treasury.json

# ---------------------------------------------------------------------------
# Provider conformance / acceptance tools (not runtime selection)
# ---------------------------------------------------------------------------
# These variables are consumed by live provider acceptance scripts. The
# provider instance and its model remain Bundle state managed by the node.
# AIDN_LLAMACPP_ENDPOINT=http://127.0.0.1:8080
# AIDN_LLAMACPP_MODEL=Qwen3.8
# AIDN_LLAMACPP_LIVE=true
# AIDN_VLLM_ENDPOINT=http://127.0.0.1:8000
# AIDN_VLLM_MODEL=
# AIDN_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# AIDN_OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# External Faucet service (used by aidn-faucet.service, not the Hypervisor)
# ---------------------------------------------------------------------------
# AIDN_FAUCET_HOST=127.0.0.1
# AIDN_FAUCET_PENDING_RECONCILE_INTERVAL_SECONDS=10
# AIDN_FAUCET_AGENT_TOKEN=
# AIDN_FAUCET_CREATOR_TOKEN=
# AIDN_FAUCET_FINALITY_CONFIG=/etc/aidn/cometbft-finality.json

# ---------------------------------------------------------------------------
# Web build-time values (read by Vite, not by the Hypervisor service)
# ---------------------------------------------------------------------------
# VITE_WEBSITE_API_BASE=/api/site/v1
# AIDN_WEBSITE_BACKEND_URL=http://127.0.0.1:8000
# VITE_WEBSITE_DEMO=false
# VITE_AIDN_INSTALL_REF=operator-bootstrap-v0.1.0-rc1
# VITE_AIDN_API_ROOT=
