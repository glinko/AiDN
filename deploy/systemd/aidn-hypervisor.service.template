[Unit]
Description=AiDN Hypervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidn
Group=aidn
WorkingDirectory=/opt/aidn/AiDN
EnvironmentFile=/etc/aidn/hypervisor.env
# Protect the environment file (root:aidn, mode 0640) and use an OS/KMS
# secret injection mechanism for AIDN_SECRET_MANAGER_MASTER_KEY in production.
ExecStart=/usr/local/bin/uv run uvicorn aidn_hypervisor.main:build_app --factory --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aidn

[Install]
WantedBy=multi-user.target
