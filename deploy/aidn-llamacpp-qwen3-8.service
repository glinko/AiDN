[Unit]
Description=AiDN local llama.cpp server for Qwen3.8 on GPU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=0
# Keep the KV cache in host RAM so the 24 GiB RTX 3090 can expose the model's
# 128K context without claiming another GPU-sized cache per server slot.
ExecStart=/home/user/.local/share/aidn/providers/llama.cpp/build-cuda/bin/llama-server --model /home/user/.local/share/aidn/gpu-3090/models/llama.cpp/Qwen3.8 --host 127.0.0.1 --port 8080 --n-gpu-layers 99 --ctx-size 131072 --no-kv-offload --cache-type-k q8_0 --cache-type-v q8_0 --parallel 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
